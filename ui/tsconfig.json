{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@druid-ui/component",
    "types": ["@druid-ui/component/jsx"]
  },
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/config-editor/test-fixtures.ts"]
}
